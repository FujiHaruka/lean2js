-- Generated from the Lean subset by leants.

type Money = Money(amount : Int53, currency : String)

type Role = guest | member | admin

type OrderState = draft | placed(orderId : Int53) | shipped(orderId : Int53, trackingId : String) | cancelled(reason : String)

type Paginated T = Paginated(items : Array T, total : Int53)

type Validated E A = valid(value : A) | invalid(errors : Array E)

def add(a : Int53, b : Int53) : Int53 =
  (a + b)

def clampQuantity(quantity : Int53, upper : Int53) : Int53 =
  if (quantity < 1) then 1 else if (quantity > upper) then upper else quantity

def lineTotal(unitPrice : Int53, quantity : Int53) : Int53 =
  (unitPrice * clampQuantity(quantity, 999))

def discounted(amount : Int53, percent : Int53) : Int53 =
  let rate : Int53 = (100 - if (percent < 0) then 0 else if (percent > 100) then 100 else percent); ((amount * rate) / 100)

def divide(a : Int53, b : Int53) : Int53 =
  (a / b)

def remainder(a : Int53, b : Int53) : Int53 =
  (a % b)

def negate(a : Int53) : Int53 =
  -a

def safeQuotientIsPositive(a : Int53, b : Int53) : Bool =
  ((b != 0) && ((a / b) > 0))

def canCheckout(signedIn : Bool, cartTotal : Int53, stock : Int53) : Bool =
  ((signedIn && (cartTotal > 0)) && (stock >= 1))

def mixChannels(a : UInt32, b : UInt32) : UInt32 =
  ((a * b) + (a - b))

def bucketOf(key : UInt32, buckets : UInt32) : UInt32 =
  (key % buckets)

def scaleFee(fee : BigInt, factor : BigInt) : BigInt =
  ((fee * factor) - 1n)

def bigQuotient(a : BigInt, b : BigInt) : BigInt =
  (a / b)

def slugOf(prefix : String, name : String) : String =
  ((prefix ++ "-") ++ name)

def sortsBefore(a : String, b : String) : Bool =
  (a < b)

def sameLabel(a : String, b : String) : Bool =
  (a == b)

def rebindTwice(amount : Int53) : Int53 =
  let amount : Int53 = (amount + 1); let amount : Int53 = (amount * 2); amount

def roleRank(role : Role) : Int53 =
  match role { guest => 0 | member => 1 | admin => 2 }

def addMoney(a : Money, b : Money) : Result Money String =
  if (a.currency != b.currency) then error[Money]("currency mismatch") else ok[String](Money.Money((a.amount + b.amount), a.currency))

def sameMoney(a : Money, b : Money) : Bool =
  (a == b)

def ship(state : OrderState, trackingId : String) : Result OrderState String =
  match state { draft => error[OrderState]("a draft order cannot ship") | placed(orderId) => if (trackingId == "") then error[OrderState]("a tracking id is required") else ok[String](OrderState.shipped(orderId, trackingId)) | shipped(orderId, trackingId) => error[OrderState]("the order has already shipped") | cancelled(reason) => error[OrderState]("a cancelled order cannot ship") }

def trackingOf(state : OrderState) : Option String =
  match state { draft => none[String] | placed(orderId) => none[String] | shipped(orderId, trackingId) => some(trackingId) | cancelled(reason) => none[String] }

def canRefund(role : Role, state : OrderState) : Bool =
  match state { draft => false | placed(orderId) => (roleRank(role) >= 1) | shipped(orderId, trackingId) => (roleRank(role) >= 2) | cancelled(reason) => false }

def total(xs : Array Int53) : Int53 =
  xs.reduce(0, (sum, x) => (sum + x))

def headOr(xs : Array Int53, fallback : Int53) : Int53 =
  if (xs.length == 0) then fallback else xs[0]

def firstTracking(states : Array OrderState) : Option String =
  if (states.length == 0) then none[String] else trackingOf(states[0])

def lineTotals(unitPrice : Int53, quantities : Array Int53) : Array Int53 =
  quantities.map(quantity => lineTotal(unitPrice, quantity))

def currenciesOf(items : Array Money) : Array String =
  items.map(item => item.currency)

def refundableOnly(role : Role, states : Array OrderState) : Array OrderState =
  states.filter(state => canRefund(role, state))

def cartTotal(items : Array Money) : Int53 =
  items.reduce(0, (subtotal, item) => (subtotal + item.amount))

def anyOverLimit(amounts : Array Int53, limit : Int53) : Bool =
  amounts.reduce(false, (seen, amount) => if seen then true else (amount > limit))

def quantityLabel(quantity : Int53) : String =
  match quantity { 0 => "out of stock" | 1 => "last one" | _ => "in stock" }

def renewalLabel(autoRenew : Bool) : String =
  match autoRenew { true => "renews" | false => "ends" }

def chargeable(amount : Money) : Bool =
  match amount { Money(0, _) => false | Money(_, "") => false | Money(value, _) => (value > 0) }

def settleMessage(outcome : Result OrderState String) : String =
  match outcome { ok(shipped(_, trackingId)) => trackingId | ok(placed(_)) => "awaiting shipment" | ok(_) => "no update" | error(message) => message }

def remainingItems(page : Paginated Money) : Int53 =
  (page.total - page.items.length)

def firstPage(amounts : Array Int53) : Paginated Int53 =
  Paginated[Int53].Paginated(amounts, amounts.length)

def validateQuantity(quantity : Int53) : Validated String Int53 =
  if (quantity < 1) then Validated[String, Int53].invalid(["a quantity must be at least 1"] : Array String) else if (quantity > 999) then Validated[String, Int53].invalid(["a quantity may not exceed 999"] : Array String) else Validated[String, Int53].valid(quantity)

def validationMessage(outcome : Validated String Int53) : String =
  match outcome { valid(value) => quantityLabel(value) | invalid(errors) => if (errors.length == 0) then "refused" else errors[0] }


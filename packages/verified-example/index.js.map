-- Generated from the Lean subset by lean2js.

type Role = guest | member | admin

type Money = Money(amount : Int53, currency : String)

type OrderState = draft | placed(orderId : Int53) | shipped(orderId : Int53, trackingId : String) | cancelled(reason : String)

type Paginated T = Paginated(items : Array T, total : Int53)

type Validated E A = valid(value : A) | invalid(errors : Array E)

def add(a : Int53, b : Int53) : Int53 =
  (a + b)

def clampQuantity(quantity : Int53, upper : Int53) : Int53 =
  if (quantity < 1) then 1 else if (quantity > upper) then upper else quantity

def lineTotal(unitPrice : Int53, quantity : Int53) : Int53 =
  (unitPrice * clampQuantity(quantity, 999))

def roleRank(role : Role) : Int53 =
  match role { guest => 0 | member => 1 | admin => 2 }

def lineTotals(unitPrice : Int53, quantities : Array Int53) : Array Int53 =
  quantities.map(quantity => lineTotal(unitPrice, quantity))

def anyOverLimit(amounts : Array Int53, limit : Int53) : Bool =
  amounts.reduce(false, (seen, amount) => if seen then true else (amount > limit))

def firstOverLimit(amounts : Array Int53, limit : Int53) : Option Int53 =
  amounts.find(amount => (amount > limit))

def everyLineWithinLimit(amounts : Array Int53, limit : Int53) : Bool =
  amounts.all(amount => (amount <= limit))

def someLineIsFree(amounts : Array Int53) : Bool =
  amounts.any(amount => (amount == 0))

def pageOf(xs : Array Int53, lo : Int53, hi : Int53) : Array Int53 =
  xs.slice(lo, hi)

def mostRecentFirst(events : Array String) : Array String =
  events.reverse()

def combinedCart(saved : Array Int53, added : Array Int53) : Array Int53 =
  (saved ++ added)

def headOr(xs : Array Int53, fallback : Int53) : Int53 =
  if (xs.length < 1) then fallback else xs[0]

def slugOf(prefix : String, name : String) : String =
  ((prefix ++ "-") ++ name)

def orderReference(prefix : String, orderNo : Int53) : String =
  ((prefix ++ "-") ++ orderNo.toString())

def amountOf(field : String) : Option Int53 =
  field.toInt()

def amountOr(field : String, fallback : Int53) : Int53 =
  match field.toInt() { some(a) => a | none => fallback }

def separatorAt(reference : String, sep : String) : Option Int53 =
  reference.indexOf(sep)

def referencePrefix(reference : String) : String =
  match reference.indexOf("-") { some(i) => reference.substring(0, i) | none => reference }

def joinFields(fields : Array String, separator : String) : String =
  fields.join(separator)

def referenceFrom(parts : Array String) : String =
  parts.join("-")

def sortsBefore(a : String, b : String) : Bool =
  (a < b)

def mentionsTerm(text : String, term : String) : Bool =
  text.toLower().includes(term.toLower())

def storedCoupon(campaign : String, entered : String) : String =
  (campaign ++ entered).trim().toUpper()

def couponApplies(code : String, campaign : String) : Bool =
  code.trim().toLower().startsWith(campaign.trim().toLower())

def fieldCount(row : String, separator : String) : Int53 =
  row.split(separator).length

def truncateLabel(label : String, limit : Int53) : String =
  if (label.length <= limit) then label else (label.substring(0, limit) ++ "...")

def isSpreadsheet(fileName : String) : Bool =
  fileName.trim().toLower().endsWith(".csv")

def limitsFor(role : Role) : Dict Int53 =
  match role { guest => {"daily": 10, "monthly": 100} : Dict Int53 | member => {"daily": 100, "monthly": 3000} : Dict Int53 | admin => {"daily": 1000, "monthly": 30000} : Dict Int53 }

def priceOf(prices : Dict Int53, sku : String) : Option Int53 =
  prices.get(sku)

def isListed(prices : Dict Int53, sku : String) : Bool =
  prices.has(sku)

def repriced(prices : Dict Int53, sku : String, amount : Int53) : Dict Int53 =
  prices.set(sku, amount)

def listedSkus(prices : Dict Int53) : Array String =
  prices.keys()

def listedPrices(prices : Dict Int53) : Array Int53 =
  prices.values()

def withdrawn(prices : Dict Int53, sku : String) : Dict Int53 =
  prices.delete(sku)

def catalogueSize(prices : Dict Int53) : Int53 =
  prices.length

def divide(a : Int53, b : Int53) : Int53 =
  (a / b)

def remainder(a : Int53, b : Int53) : Int53 =
  (a % b)

def negate(a : Int53) : Int53 =
  -a

def priceGap(a : Int53, b : Int53) : Int53 =
  (a - b).abs()

def discounted(amount : Int53, percent : Int53) : Int53 =
  let rate : Int53 = (100 - if (percent < 0) then 0 else if (percent > 100) then 100 else percent); ((amount * rate) / 100)

def tenPercentOff(amount : Int53) : Int53 =
  (amount - (amount / 10))

def rebindTwice(amount : Int53) : Int53 =
  let amount : Int53 = (amount + 1); let amount : Int53 = (amount * 2); amount

def noDiscount(amount : Int53) : Int53 =
  amount

def priced(rule : (Int53) => Int53, amount : Int53) : Int53 =
  rule(amount)

def memberPrice(amount : Int53) : Int53 =
  priced(@tenPercentOff, amount)

def guestPrice(amount : Int53) : Int53 =
  priced(@noDiscount, amount)

def mixChannels(a : UInt32, b : UInt32) : UInt32 =
  ((a * b) + (a - b))

def bucketOf(key : UInt32, buckets : UInt32) : UInt32 =
  (key % buckets)

def clampChannel(value : UInt32, lo : UInt32, hi : UInt32) : UInt32 =
  value.max(lo).min(hi)

def scaleFee(fee : BigInt, factor : BigInt) : BigInt =
  ((fee * factor) - 1n)

def bigQuotient(a : BigInt, b : BigInt) : BigInt =
  (a / b)

def sameLabel(a : String, b : String) : Bool =
  (a == b)

def safeQuotientIsPositive(a : Int53, b : Int53) : Bool =
  ((b != 0) && ((a / b) > 0))

def canCheckout(signedIn : Bool, cartTotal : Int53, stock : Int53) : Bool =
  ((signedIn && (cartTotal > 0)) && (stock >= 1))

def cappedCharge(amount : Int53, budget : Int53) : Int53 =
  amount.min(budget)

def atLeast(amount : Int53, floor : Int53) : Int53 =
  amount.max(floor)

def addMoney(a : Money, b : Money) : Result Money String =
  if (a.currency != b.currency) then error[Money]("currency mismatch") else ok[String](Money.Money((a.amount + b.amount), a.currency))

def sameMoney(a : Money, b : Money) : Bool =
  (a == b)

def currenciesOf(items : Array Money) : Array String =
  items.map(item => item.currency)

def cartTotal(items : Array Money) : Int53 =
  items.reduce(0, (subtotal, item) => (subtotal + item.amount))

def total(xs : Array Int53) : Int53 =
  xs.reduce(0, (sum, x) => (sum + x))

def trackingOf(state : OrderState) : Option String =
  match state { draft => none[String] | placed(_) => none[String] | shipped(_, trackingId) => some(trackingId) | cancelled(_) => none[String] }

def canRefund(role : Role, state : OrderState) : Bool =
  match state { draft => false | placed(_) => (roleRank(role) >= 1) | shipped(_, _) => (roleRank(role) >= 2) | cancelled(_) => false }

def firstTracking(states : Array OrderState) : Option String =
  if (states.length == 0) then none[String] else trackingOf(states[0])

def refundableOnly(role : Role, states : Array OrderState) : Array OrderState =
  states.filter(state => canRefund(role, state))

def ship(state : OrderState, trackingId : String) : Result OrderState String =
  match state { draft => error[OrderState]("a draft order cannot ship") | placed(orderId) => if (trackingId == "") then error[OrderState]("a tracking id is required") else ok[String](OrderState.shipped(orderId, trackingId)) | shipped(_, _) => error[OrderState]("the order has already shipped") | cancelled(_) => error[OrderState]("a cancelled order cannot ship") }

def quantityLabel(quantity : Int53) : String =
  match quantity { 0 => "out of stock" | 1 => "last one" | _ => "in stock" }

def renewalLabel(autoRenew : Bool) : String =
  match autoRenew { true => "renews" | false => "ends" }

def chargeable(amount : Money) : Bool =
  match amount { Money(0, _) => false | Money(_, "") => false | Money(value, _) => (value > 0) }

def settleMessage(outcome : Result OrderState String) : String =
  match outcome { ok(shipped(_, trackingId)) => trackingId | ok(placed(_)) => "awaiting shipment" | ok(_) => "no update" | error(message) => message }

def settledOrderId(outcome : Result OrderState String) : Int53 =
  match outcome { ok(placed(orderId)) => orderId | _ => 0 }

def dailyLimit(role : Role) : Int53 =
  match limitsFor(role).get("daily") { some(value) => value | none => 0 }

def monthlyLimit(role : Role) : Int53 =
  match limitsFor(role).get("monthly") { some(value) => value | _ => 0 }

def remainingItems(page : Paginated Money) : Int53 =
  (page.total - page.items.length)

def firstPage(amounts : Array Int53) : Paginated Int53 =
  Paginated[Int53].Paginated(amounts, amounts.length)

def validateQuantity(quantity : Int53) : Validated String Int53 =
  if (quantity < 1) then Validated[String, Int53].invalid(["a quantity must be at least 1"] : Array String) else if (quantity > 999) then Validated[String, Int53].invalid(["a quantity may not exceed 999"] : Array String) else Validated[String, Int53].valid(quantity)

def validationMessage(outcome : Validated String Int53) : String =
  match outcome { valid(value) => quantityLabel(value) | invalid(errors) => if (errors.length == 0) then "refused" else errors[0] }

def amountWithTax(amount : Int53) : Array Int53 =
  [amount, (amount / 10)] : Array Int53

def currencyOf(item : Money) : String =
  item.currency

def previewLines(amounts : Array Int53, upTo : Int53) : Array Int53 =
  amounts.slice(0, upTo)

def linesBelowFold(amounts : Array Int53, upTo : Int53) : Array Int53 =
  amounts.slice(upTo, amounts.length)

def cartIsEmpty(items : Array Money) : Bool =
  (items.length == 0)

def stocksSku(skus : Array String, sku : String) : Bool =
  skus.any(y => (y == sku))

def amountsTotal(amounts : Array Int53) : Int53 =
  amounts.reduce(0, (running, y) => (running + y))

def spreadsheetCount(fileNames : Array String) : Int53 =
  fileNames.reduce(0, (running, y) => if isSpreadsheet(y) then (running + 1) else running)

def firstAmount(amounts : Array Int53) : Option Int53 =
  if (amounts.length == 0) then none[Int53] else some(amounts[0])

def latestEvent(events : Array String) : Option String =
  if (events.length == 0) then none[String] else some(events[(events.length - 1)])

def allLines(orders : Array Array Int53) : Array Int53 =
  orders.reduce([] : Array Int53, (running, xs) => (running ++ xs))

def linesWithTax(amounts : Array Int53) : Array Int53 =
  amounts.reduce([] : Array Int53, (running, x) => (running ++ amountWithTax(x)))

def noteIsBlank(note : String) : Bool =
  (note.trim().length == 0)

def priceOr(prices : Dict Int53, sku : String, fallback : Int53) : Int53 =
  match prices.get(sku) { some(a) => a | none => fallback }

def byCurrency(items : Array Money) : Dict Money =
  items.reduce({} : Dict Money, (d, x) => d.set(currencyOf(x), x))

def quantityOr(quantity : Option Int53, fallback : Int53) : Int53 =
  match quantity { some(a) => a | none => fallback }

def discountedIfAny(amount : Option Int53) : Option Int53 =
  match amount { some(a) => some(tenPercentOff(a)) | none => none[Int53] }

def settledOrElse(outcome : Result Money String, fallback : Money) : Money =
  match outcome { ok(a) => a | error(_) => fallback }

def settledCurrency(outcome : Result Money String) : Result String String =
  match outcome { ok(a) => ok[String](currencyOf(a)) | error(err) => error[String](err) }

def loudRefusal(outcome : Result Money String) : Result Money String =
  match outcome { ok(a) => ok[String](a) | error(err) => error[Money](err.toUpper()) }

def settledMoney(outcome : Result Money String) : Option Money =
  match outcome { ok(a) => some(a) | error(_) => none[Money] }

